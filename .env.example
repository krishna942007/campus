# =======================================================
# VITARA 2.0 — Vercel Environment Variables Reference
# =======================================================

# MongoDB Atlas Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net
DB_NAME=vitara

# JWT Authentication
ACCESS_TOKEN_SECRET=your_super_secret_access_key_2026
REFRESH_TOKEN_SECRET=your_super_secret_refresh_key_2026
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=10d

# AI Intelligence & RAG Keys
GEMINI_API_KEY=your_google_gemini_api_key
HUGGINGFACE_API_KEY=your_optional_huggingface_api_key

# Node Environment
NODE_ENV=production
