# Server Configuration
PORT=5000
NODE_ENV=production
CORS_ORIGIN=https://your-frontend-domain.com

# Database Configuration (MongoDB Atlas Cloud)
MONGODB_USERNAME=your_db_username
MONGODB_PASSWORD=your_db_password
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net
DB_NAME=vitara

# Authentication Secrets (JWT)
ACCESS_TOKEN_SECRET=your_access_token_secret_2026
REFRESH_TOKEN_SECRET=your_refresh_token_secret_2026
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=10d

# AI Engine API Keys
GEMINI_API_KEY=your_google_gemini_api_key
HUGGINGFACE_API_KEY=your_huggingface_api_key
